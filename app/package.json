{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node -e \"console.log('\\n  → http://127.0.0.1:3000  |  http://localhost:3000\\n  Other port: npm run dev:3100\\n')\" && next dev --webpack -p 3000",
    "dev:3100": "node -e \"console.log('\\n  → http://127.0.0.1:3100  |  http://localhost:3100\\n')\" && next dev --webpack -p 3100",
    "dev:cursor": "next dev --webpack -p 3490",
    "build": "next build --webpack",
    "start": "next start",
    "db:link": "npx --yes supabase@latest link --project-ref aprjlwajbubjddtbqufk --yes",
    "db:push": "npx --yes supabase@latest db push",
    "db:status": "npx --yes supabase@latest migration list",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:i18n": "node scripts/check-i18n.mjs",
    "generate:quick-task-presets": "npx --yes tsx scripts/generate-quick-task-preset-icons.ts",
    "test:bio-lab": "node --experimental-strip-types scripts/test-bio-lab-pure.ts",
    "test:knowledge": "node --experimental-strip-types --import ./scripts/test-node-alias-resolver.mjs scripts/test-knowledge-classify.ts",
    "test:knowledge-taxonomy-zod": "node scripts/test-knowledge-dynamic-taxonomy-zod.mjs",
    "test:quote-library": "node --experimental-strip-types scripts/test-quote-library-pure.ts",
    "test:brain": "node --experimental-strip-types --import ./scripts/test-node-alias-resolver.mjs scripts/test-brain-engine.ts",
    "seed:prompt-library": "node --experimental-strip-types --env-file=.env.local scripts/seed-prompt-library.ts",
    "seed:prompt-library:dry": "node --experimental-strip-types --env-file=.env.local scripts/seed-prompt-library.ts --dry-run",
    "seed:awesome-prompts:export-sql": "node --experimental-strip-types --env-file=.env.local scripts/seed-prompt-library.ts --export-sql supabase/migrations/20260430120000_seed_ai_boost_awesome_prompts.sql",
    "vercel:prod": "cd .. && npx --yes vercel@latest deploy --prod --yes"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.52.0",
    "@sparticuz/chromium": "^131.0.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/d3-force": "^3.0.10",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie": "^1.0.2",
    "d3-force": "^3.0.0",
    "dagre": "^0.8.5",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "docx-preview": "^0.3.7",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.3.0",
    "googleapis": "^146.0.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.59.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-dropzone": "^15.0.0",
    "react-force-graph-2d": "^1.29.1",
    "react-force-graph-3d": "^1.29.1",
    "react-is": "^19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "youtube-transcript": "^1.2.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/dagre": "^0.7.54",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.40",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@vitest/expect": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
